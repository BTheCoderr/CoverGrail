# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Use either the legacy anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin key. Use one of these, never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Stable public origin used for magic-link and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comic grading. Use mock mode until a production vision model is configured.
MOCK_GRADE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Temporary sample-data QA mode. Keep false in production.
NEXT_PUBLIC_DEMO_MODE=false

# Optional Stripe billing.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE_SCAN=
STRIPE_PRICE_COLLECTOR_MONTHLY=
STRIPE_PRICE_DEALER_MONTHLY=
